# Copia este archivo como `.env` (no se versiona) antes de `docker compose --profile app up`.

# Clave con la que se firman los tokens de sesión. Mínimo 32 caracteres. Genera una propia con:
#   openssl rand -base64 48
JWT_SECRET=

# Crea el workspace "Demo" con tres usuarios de prueba (contraseña Demo1234). Ponlo en false fuera de una demo.
SEED_DEMO_DATA=true

# Opcional: token de GitHub SIN permisos. Sube el límite de la API de 60 a 5000 consultas por hora.
GITHUB_TOKEN=

# Puerto del host donde queda la aplicación.
WEB_PORT=8080

# Intentos de login o registro permitidos por IP y por minuto. Súbelo (por ejemplo a 1000) solo para correr
# las pruebas de navegador, que hacen muchos registros desde una misma IP.
AUTH_RATE_LIMIT=10
