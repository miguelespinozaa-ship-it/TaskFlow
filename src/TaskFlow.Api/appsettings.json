{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=taskflow;Username=taskflow;Password=taskflow"
  },
  "Jwt": {
    "Issuer": "taskflow-api",
    "Audience": "taskflow-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "GitHub": {
    "SyncIntervalMinutes": 5
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  }
}
